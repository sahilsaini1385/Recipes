# Frontend (safe to expose — the anon key is public by design; data access is
# enforced by Row Level Security in Postgres)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Edge function secret, set with: supabase secrets set ANTHROPIC_API_KEY=...
# Never expose in client code, never commit.
# ANTHROPIC_API_KEY=sk-ant-...
