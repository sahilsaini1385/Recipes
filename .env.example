# Frontend (safe to expose — the anon key is public by design; data access is
# enforced by Row Level Security in Postgres)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Seed script only (NEVER expose in client code, never commit)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Edge function secret, set with: supabase secrets set ANTHROPIC_API_KEY=...
# ANTHROPIC_API_KEY=sk-ant-...
